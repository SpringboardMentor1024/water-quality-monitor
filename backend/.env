# --- Database Configuration ---
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# REPLACE 'your_password' with your actual PostgreSQL password!
DATABASE_URL=postgresql://postgres:1234@localhost:5432/water_quality

# --- Security Configuration (Required for Login/JWT) ---
# This random string is used to sign your security tokens.
# You can generate a new one by running `openssl rand -hex 32` in your terminal if you want.
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# Algorithm used for encryption (Standard for JWT)
ALGORITHM=HS256

# How long a user stays logged in (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30